<?xml version='1.0' encoding='UTF-8' standalone='yes' ?>
<Robot type="FirstInspires-FTC">
    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <LynxModule name="Control Hub" port="173">
            <Motor name="front_left_drive" port="0" />
            <Motor name="front_right_drive" port="1" />
            <Motor name="back_left_drive" port="2" />
            <Motor name="back_right_drive" port="3" />

            <CRServo name="corner_sweep_servo" port="5" />
        </LynxModule>
        <LynxModule name="Expansion Hub" port="2">
            <Motor name="intake_motor" port="0" />
            <Motor name="flywheel_motor" port="1" />
            
            <Servo name="flower_sweep_servo" port="5" />

            <GoBildaPinpoint name="pinpoint" port="3" bus="1" />
        </LynxModule>
    </LynxUsbDevice>
</Robot>
